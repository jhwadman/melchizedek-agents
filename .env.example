# ── Required for cloud models ─────────────────────────────────────────────────
# Google AI Studio API key — powers all Gemini model inference.
# Also required for the gemini-embedding-001 embedding model used by long-term memory.
# Get yours free at: https://aistudio.google.com
# NOT needed for all-local syndicates (tutor, council) — see the Ollama note below.
GOOGLE_GENAI_API_KEY=

# ── Optional: Ollama (open-weight local models) ───────────────────────────────
# NO KEY NEEDED. Syndicates whose every agent uses an ollama/* model id (e.g.
# ollama/qwen3:8b) run entirely on your machine via Ollama's OpenAI-compatible
# API — install from https://ollama.com and `ollama pull qwen3:8b`.
# Set this only to point at a non-default Ollama endpoint.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Where the task tools and the background worker (npm run assistant:worker)
# keep their task list and job queue. Default: outputs/tasks.json.
# MELCHIZEDEK_TASKS_FILE=outputs/tasks.json

# ── Optional: MCP (Model Context Protocol) ────────────────────────────────────
# ALLOW_PRIVATE_MCP: set to "true" to permit mcp_server_url values pointing at
# localhost / private / link-local hosts. Off by default as an SSRF guard;
# turn it on for local development — e.g. the librarian demo (npm run mcp:demo).
ALLOW_PRIVATE_MCP=false

# ── Optional: Anthropic / Claude ──────────────────────────────────────────────
# Required only when using claude-* model identifiers in syndicate YAML configs.
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Optional: OpenAI / GPT ────────────────────────────────────────────────────
# Required only when using gpt-* (or o-series) model identifiers in YAML.
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Optional: xAI / Grok ──────────────────────────────────────────────────────
# Required only when using grok-* model identifiers in YAML.
# Get your key at: https://console.x.ai
XAI_API_KEY=

# XAI_COLLECTION_IDS: comma-separated xAI Collection ids searched by the
# `collections_search` tool (grok-* agents only). Create collections and
# upload documents at console.x.ai. Declared with no ids set, the tool is
# omitted with a warning. Optional cap: XAI_COLLECTIONS_MAX_RESULTS.
# XAI_COLLECTION_IDS=collection_abc123,collection_def456
# XAI_COLLECTIONS_MAX_RESULTS=10

# Optional server-side constraints for the x_search tool (grok-* agents only).
# Dates are YYYY-MM-DD (inclusive); handle lists are comma-separated (max 20,
# leading @ tolerated) and mutually exclusive — if both are set the allowlist
# wins. Malformed values degrade with a warning, never fatally.
# XAI_X_SEARCH_FROM_DATE=2026-08-01
# XAI_X_SEARCH_TO_DATE=2026-08-08
# XAI_X_SEARCH_ALLOWED_HANDLES=Reuters,AP
# XAI_X_SEARCH_EXCLUDED_HANDLES=spam_account

# Optional server-side domain filters for the web_search tool on grok-* agents
# (comma-separated, max 5, mutually exclusive — allowlist wins if both set;
# OpenAI's web_search ignores these and always ships bare). NOTE: xAI's
# web_search accepts NO date bounds — from_date/to_date are x_search-only.
# XAI_WEB_SEARCH_ALLOWED_DOMAINS=reuters.com,apnews.com
# XAI_WEB_SEARCH_EXCLUDED_DOMAINS=pinterest.com

# ── Optional: Supabase (Session Persistence & Long-Term Memory) ───────────────
# Required when memory_system is "session-only" or "long-term" in a syndicate YAML.
# Without these, the framework falls back to in-memory sessions (no persistence).
#
# Setup: Create a free project at https://supabase.com, then go to:
#   Project Settings → API → Project URL     → paste below as SUPABASE_URL
#   Project Settings → API → service_role key → paste below as SUPABASE_SERVICE_ROLE_KEY
#
# Install the schema before sessions and memory will work:
#   npx melchizedek-db print   (paste into the Supabase SQL Editor), or
#   npx melchizedek-db apply   (with DATABASE_URL set; needs psql)
# Clone: npm run db -- print | apply. It runs db/migrations/*.sql, then db/hardening.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional: Telemetry Sink ──────────────────────────────────────────────────
# Set to "true" (with the Supabase credentials above) to persist every model
# request's tokens/latency (llm.request spans) and syndicate-run spans to the
# adk_telemetry table. Provision it first: run db/telemetry.sql in the Supabase
# SQL Editor, then re-run db/hardening.sql. See DOCUMENTATION.md §5.
TELEMETRY_SUPABASE=false

# ── Optional: A2A Server ──────────────────────────────────────────────────────
# A2A_SERVER_SECRET: Bearer token used to authenticate incoming A2A requests.
# If set, all requests must include: Authorization: Bearer <this_value>
# If not set, the A2A server runs without authentication and binds 127.0.0.1 only.
# Generate one with: openssl rand -hex 32
# REQUIRED in production: if PUBLIC_URL is set, the server REFUSES TO START
# without this secret, to avoid exposing an unauthenticated endpoint.
A2A_SERVER_SECRET=

# PUBLIC_URL: The publicly accessible base URL of the A2A server.
# Used when compiling the AgentCard that advertises this agent to A2A clients.
# Defaults to http://localhost:4000 if not set.
# Only needed for cloud deployments where the server has a real public URL.
PUBLIC_URL=

# ── A2A server: binding, limits, lifecycle (all optional) ─────────────────────
# Without A2A_SERVER_SECRET the server binds 127.0.0.1 only. To bind another
# address without a secret you must also set ALLOW_UNAUTHENTICATED=true.
# PORT=4000
# HOST=0.0.0.0
# ALLOW_UNAUTHENTICATED=false
# Only these agent ids are served at /<agentId>/... (comma list). Unset = any
# syndicate the loader can find.
# A2A_SERVED_AGENTS=support_triage,research_brief
# Per-task wall-clock budget (ms; 0 = none). Default 15 minutes.
# A2A_TASK_TIMEOUT_MS=900000
# Concurrent tasks across all agents (0 = unlimited).
# A2A_MAX_CONCURRENT_TASKS=0
# Task submissions per window per client IP, and failed logins before an IP is blocked.
# A2A_RATE_LIMIT_MAX=60
# A2A_RATE_LIMIT_WINDOW_MS=900000
# A2A_AUTH_FAILURE_MAX=30
# Express trust-proxy: proxy hop count, true/false, or a subnet list. Default 1.
# A2A_TRUST_PROXY=1
# A2A_BODY_LIMIT=1mb
# How long SIGTERM waits for running tasks before canceling them.
# A2A_SHUTDOWN_GRACE_MS=25000
# Postgres connection string, used only by `melchizedek-db apply`.
# DATABASE_URL=

# ── Optional: Knowledge Bundle (wiki) ─────────────────────────────────────────
# WIKI_ROOT: filesystem path of the OKF knowledge bundle the wiki tools serve.
# Defaults to <repo>/wiki (this repo ships its bundle there). Point it at any
# other OKF bundle — the tooling is bundle-agnostic (npm run wiki:init).
WIKI_ROOT=

# MCP_WIKI_PORT: port for the wiki MCP server (npm run mcp:wiki). Default 8933.
MCP_WIKI_PORT=

# WIKI_AGENT_MODEL: model for wiki_query / wiki_garden. Any registry-routable
# string (gemini-*, claude-*, ollama/*, ...). Default: gemini-3.8-flash.
WIKI_AGENT_MODEL=

# ── Optional: one gateway key for providers you have no key for ───────────────
# A model whose direct key is ABSENT is served through the gateway's OpenAI-
# compatible endpoint (native search tools are dropped on that path; the
# doctor says which). A present direct key always wins.
# MODEL_GATEWAY=vercel            # or openrouter
# MODEL_GATEWAY_API_KEY=
# MODEL_GATEWAY_BASE_URL=         # optional: a self-hosted proxy speaking the same dialect
# MODEL_GATEWAY_MODEL_MAP=        # optional: "claude-sonnet-4-6=anthropic/claude-sonnet-4.6,..."

# ── Optional: tracing ─────────────────────────────────────────────────────────
# Send every span to any OTLP/HTTP backend (Phoenix, Langfuse, Jaeger, Tempo):
# a local Phoenix is `docker run -p 6006:6006 arizephoenix/phoenix`.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
# OTEL_SERVICE_NAME=melchizedek
# Print [OTEL_SPAN_JSON] lines to stdout. Off by default: the root span carries
# the full user message and answer.
# OTEL_CONSOLE_SPANS=false
# Which model calls keep their full request/response in adk_payloads
# (off | errors | sample | all), the sample fraction, and the expiry.
# TELEMETRY_PAYLOADS=sample
# TELEMETRY_PAYLOAD_SAMPLE=0.10
# TELEMETRY_PAYLOAD_TTL_DAYS=30

# ── Optional: misc ────────────────────────────────────────────────────────────
# Where syndicate YAMLs are found. Default: <cwd>/config/agents.
# MELCHIZEDEK_AGENTS_DIR=
# Bearer credentials for MCP servers that need one: a JSON object of
# hostname → token, sent only to that exact host and only over https.
# MCP_BEARER_TOKENS={"mcp.example.com":"..."}
# Per-page character budget for web_extract (default 15000).
# WEB_EXTRACT_CHAR_LIMIT=15000

# ── Optional: provider retries ────────────────────────────────────────────────
# Transient provider failures (408/409/425/429/5xx, connection resets) are
# retried with jittered backoff, honouring Retry-After up to 60 s, before any
# output is produced. Total attempts per model call; 1 turns retries off.
# MODEL_RETRY_MAX_ATTEMPTS=3
# Per-attempt timeout for xAI (Grok) calls, ms; floor 120000.
# XAI_TIMEOUT_MS=600000

# ── Optional: long-term memory providers ──────────────────────────────────────
# Fact extraction runs on any model id (routed like an agent's model); the
# embedder is gemini (default), openai, ollama or any OpenAI-compatible
# endpoint. The dimension must match the vector column (768 in db/migrations).
# MEMORY_EXTRACTION_MODEL=gemini-3.8-flash
# MEMORY_EMBEDDING_PROVIDER=gemini
# MEMORY_EMBEDDING_MODEL=
# MEMORY_EMBEDDING_DIMENSIONS=768
# MEMORY_EMBEDDING_BASE_URL=        # required for openai-compatible
# MEMORY_EMBEDDING_API_KEY=         # for openai-compatible
