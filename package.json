{
  "name": "melchizedek-agents",
  "version": "0.9.2",
  "description": "A multi-model, multi-agent orchestration framework on Google ADK — YAML-defined syndicates, Supabase session persistence, pgvector long-term memory. Companion repo to the lyceumagents.com curriculum.",
  "type": "module",
  "license": "MIT",
  "//": "adk + genai are pinned exact in dev: newer genai minors change response part shapes and silently break the chat printer. Bump deliberately, verify a live run, then update the pin. adk itself is a PEER dependency — the consumer's app owns the ADK instance so the model registry is a singleton.",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": "./dist/lib/index.js",
    "./loadSyndicate": "./dist/lib/loadSyndicate.js",
    "./loadEnv": "./dist/lib/loadEnv.js",
    "./dispatch": "./dist/lib/dispatch.js",
    "./grounding": "./dist/lib/grounding.js",
    "./config": "./dist/lib/config.js",
    "./models/*": "./dist/lib/models/*.js",
    "./tools": "./dist/lib/toolRegistry.js",
    "./tools/*": "./dist/lib/tools/*.js",
    "./memory": "./dist/lib/memory/supabaseMemoryService.js",
    "./session/*": "./dist/lib/session/*.js",
    "./persistence/*": "./dist/lib/persistence/*.js",
    "./observability/*": "./dist/lib/observability/*.js",
    "./wiki/*": "./dist/lib/wiki/*.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "melchizedek-serve": "./dist/scripts/a2a_server.js",
    "melchizedek-chat": "./dist/scripts/syndicate_chat.js"
  },
  "files": [
    "dist",
    "config/agents/README.md",
    "config/agents/syndicateSchema.yaml",
    "config/agents/examples",
    "QUICKSTART.md",
    "DOCUMENTATION.md",
    "AGENT_SETUP.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "chat:syndicate": "node --disable-warning=DEP0040 --experimental-strip-types scripts/syndicate_chat.ts",
    "syndicate:synthesis": "node --disable-warning=DEP0040 --experimental-strip-types scripts/syndicate_chat.ts --syndicate syndicate",
    "syndicate:delegation": "node --disable-warning=DEP0040 --experimental-strip-types scripts/syndicate_chat.ts --syndicate delegation",
    "syndicate:critic": "node --disable-warning=DEP0040 --experimental-strip-types scripts/syndicate_chat.ts --syndicate critic",
    "syndicate:hierarchical": "node --disable-warning=DEP0040 --experimental-strip-types scripts/syndicate_chat.ts --syndicate hierarchical",
    "syndicate:style": "node --disable-warning=DEP0040 --experimental-strip-types scripts/syndicate_chat.ts --syndicate style_council",
    "syndicate:image": "node --disable-warning=DEP0040 --experimental-strip-types scripts/syndicate_chat.ts --syndicate image_production",
    "syndicate:ares": "node --disable-warning=DEP0040 --experimental-strip-types scripts/syndicate_chat.ts --syndicate ares",
    "syndicate:claude": "node --disable-warning=DEP0040 --experimental-strip-types scripts/syndicate_chat.ts --syndicate claude",
    "syndicate:advocate": "node --disable-warning=DEP0040 --experimental-strip-types scripts/syndicate_chat.ts --syndicate patient_advocate",
    "syndicate:tutor": "node --disable-warning=DEP0040 --experimental-strip-types scripts/syndicate_chat.ts --syndicate tutor",
    "syndicate:council": "node --disable-warning=DEP0040 --experimental-strip-types scripts/syndicate_chat.ts --syndicate council",
    "syndicate:librarian": "node --disable-warning=DEP0040 --experimental-strip-types scripts/syndicate_chat.ts --syndicate librarian",
    "syndicate:scriptorium": "node --disable-warning=DEP0040 --experimental-strip-types scripts/syndicate_chat.ts --syndicate scriptorium",
    "syndicate:cartographers": "node --disable-warning=DEP0040 --experimental-strip-types scripts/syndicate_chat.ts --syndicate cartographers",
    "syndicate:augustin": "node --disable-warning=DEP0040 --experimental-strip-types scripts/syndicate_chat.ts --syndicate augustin",
    "demo:models": "node --disable-warning=DEP0040 --experimental-strip-types scripts/demo_model_optionality.ts",
    "demo:direct": "node --disable-warning=DEP0040 --experimental-strip-types scripts/direct_call.ts",
    "mcp:demo": "node --disable-warning=DEP0040 --experimental-strip-types scripts/demo_mcp_server.ts",
    "mcp:wiki": "node --disable-warning=DEP0040 --experimental-strip-types scripts/wiki/mcp_server.ts",
    "wiki:init": "node --disable-warning=DEP0040 --experimental-strip-types scripts/wiki/init.ts",
    "wiki:check": "node --disable-warning=DEP0040 --experimental-strip-types scripts/wiki/check.ts",
    "start:a2a": "node --disable-warning=DEP0040 --experimental-strip-types scripts/a2a_server.ts",
    "test": "node --disable-warning=DEP0040 --experimental-strip-types --test tests/**/*.test.ts",
    "memory": "node --disable-warning=DEP0040 --experimental-strip-types scripts/memory_admin.ts",
    "db:purge": "node --disable-warning=DEP0040 --experimental-strip-types scripts/purge_supabase.ts"
  },
  "peerDependencies": {
    "@google/adk": "^1.3.0"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "@anthropic-ai/sdk": "^0.96.0",
    "@google/genai": "2.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@supabase/supabase-js": "^2.43.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "openai": "^6.48.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@google/adk": "1.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "typescript": "^5.9.0"
  }
}
